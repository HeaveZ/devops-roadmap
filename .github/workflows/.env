run: |                                                                                                                    
      echo "POSTGRES_USER=${{ secrets.POSTGRES_USER }}" >> .env
      echo "POSTGRES_PASSWORD=${{ secrets.POSTGRES_PASSWORD }}" >> .env                                                       
      echo "DATABASE_URL=${{ secrets.DATABASE_URL }}" >> .env          
      echo "AWS_ACCESS_KEY_ID=${{ secrets.AWS_ACCESS_KEY_ID }}" >> .env                                                       
      echo "AWS_SECRET_ACCESS_KEY=${{ secrets.AWS_SECRET_ACCESS_KEY }}" >> .env
      echo "AWS_REGION=${{ secrets.AWS_REGION }}" >> .env                                                                     
      echo "AWS_BUCKET_NAME=${{ secrets.AWS_BUCKET_NAME }}" >> .env                                                           
      echo "JWT_SECRET=${{ secrets.JWT_SECRET }}" >> .env          
      echo "DEFAULT_USER_PASSWORD_AZIZ=${{ secrets.DEFAULT_USER_PASSWORD_AZIZ }}" >> .env                                     
      echo "DEFAULT_USER_PASSWORD_IBRAHIM=${{ secrets.DEFAULT_USER_PASSWORD_IBRAHIM }}" >> .env
      echo "DEFAULT_USER_PASSWORD_NACTEZ=${{ secrets.DEFAULT_USER_PASSWORD_NACTEZ }}" >> .env  
